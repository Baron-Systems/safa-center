# انسخ هذا الملف إلى .env.local (محلياً) أو .env.production.local (على السيرفر) وعدّل القيم.

# رابط الموقع النهائي (لـ SEO و sitemap)
NEXT_PUBLIC_SITE_URL=https://alsafa-surgeries.com

# مجلد قاعدة البيانات والصور المرفوعة — خارج مجلد الكود ليبقى عند التحديث، وخذ منه نسخاً احتياطية
DATA_DIR=/var/lib/alsafa

# حدود الاستخدام (اختياري — هذه القيم الافتراضية)
MEDIA_QUOTA_MB=1024      # الحد الأقصى لمجموع الصور
MAX_IMAGE_MB=2           # الحد الأقصى للصورة الواحدة
MAX_POSTS=2000           # الحد الأقصى لعدد المنشورات
MAX_SLIDES=10            # صور كاروسيل الواجهة
MAX_GALLERY=24           # صور شريط «من نحن»
